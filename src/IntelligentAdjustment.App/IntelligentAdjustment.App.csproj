<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyName>Intelligent Adjustment</AssemblyName>
    <AssemblyTitle>Intelligent Adjustment</AssemblyTitle>
    <Product>Intelligent Adjustment</Product>
    <Description>高程控制网平差与成果分析工具</Description>
    <Copyright>© 2026 Intelligent Adjustment</Copyright>
    <ApplicationIcon>Assets\IntelligentAdjustment.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IntelligentAdjustment.Application/IntelligentAdjustment.Application.csproj" />
    <ProjectReference Include="../IntelligentAdjustment.Domain/IntelligentAdjustment.Domain.csproj" />
    <ProjectReference Include="../IntelligentAdjustment.Core/IntelligentAdjustment.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\IntelligentAdjustment.ico" />
    <Content Include="Languages\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Help\ManualBase64\manual.part*.txt">
      <LogicalName>IntelligentAdjustment.App.Help.ManualBase64.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="Help\ManualBase64\manual.part*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>

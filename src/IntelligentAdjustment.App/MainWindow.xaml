<Window x:Class="IntelligentAdjustment.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1380"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建工程(_N)" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="打开工程(_O)" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="保存工程(_S)" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="工程另存为..." Command="{Binding SaveProjectAsCommand}"/>
                <MenuItem Header="关闭工程" Command="{Binding CloseProjectCommand}"/>
                <Separator/>
                <MenuItem Header="仪器数据导入..." Command="{Binding OpenInstrumentImportCommand}"/>
                <MenuItem Header="直接导入高差 OUT..." Command="{Binding ImportOutCommand}"/>
                <Separator/>
                <MenuItem Header="报告与导出..." Command="{Binding OpenReportCommand}"/>
                <Separator/>
                <MenuItem Header="退出" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="重做" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="计算(_C)">
                <MenuItem Header="搜索闭合/附合路线" Command="{Binding SearchRoutesCommand}"/>
                <MenuItem Header="高程平差" Command="{Binding CalculateAdjustmentCommand}"/>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="工程概览" Command="{Binding OpenDashboardCommand}"/>
                <MenuItem Header="线路管理" Command="{Binding OpenLineManagementCommand}"/>
                <MenuItem Header="原始观测" Command="{Binding OpenRawObservationsCommand}"/>
                <MenuItem Header="高差观测" Command="{Binding OpenLevelDifferencesCommand}"/>
                <MenuItem Header="已知高程" Command="{Binding OpenKnownHeightsCommand}"/>
                <MenuItem Header="网形草图" Command="{Binding OpenMapSketchCommand}"/>
                <MenuItem Header="水准网图" Command="{Binding OpenNetworkGraphCommand}"/>
                <MenuItem Header="报告与导出" Command="{Binding OpenReportCommand}"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="工程设置" Command="{Binding OpenProjectSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 IntelligentAdjustment" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding NewProjectCommand}" ToolTip="新建工程">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="16"/><TextBlock Text=" 新建"/></StackPanel>
                </Button>
                <Button Command="{Binding OpenProjectCommand}" ToolTip="打开工程">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="📂"/><TextBlock Text=" 打开"/></StackPanel>
                </Button>
                <Button Command="{Binding SaveProjectCommand}" ToolTip="保存工程">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="💾"/><TextBlock Text=" 保存"/></StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding UndoCommand}" ToolTip="撤销 (Ctrl+Z)">
                    <TextBlock Text="撤销"/>
                </Button>
                <Button Command="{Binding RedoCommand}" ToolTip="重做 (Ctrl+Y)">
                    <TextBlock Text="重做"/>
                </Button>
                <Separator/>
                <Button Command="{Binding OpenInstrumentImportCommand}" ToolTip="按仪器厂商/格式导入数据">
                    <TextBlock Text="仪器导入"/>
                </Button>
                <Button Command="{Binding ImportOutCommand}" ToolTip="直接导入 OUT 高差数据">
                    <TextBlock Text="导入 OUT"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentProjectPath, TargetNullValue=未打开工程}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="90" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D7DCE2"
                    BorderThickness="0,0,1,0"
                    Background="#F7F8FA">
                <Border.Resources>
                    <Style x:Key="NavigationExpanderStyle" TargetType="Expander">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Margin" Value="0,4,0,4"/>
                    </Style>
                    <Style x:Key="NavigationButtonStyle" TargetType="Button">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Padding" Value="12,5"/>
                    </Style>
                </Border.Resources>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Expander Header="工程"
                                  Style="{StaticResource NavigationExpanderStyle}">
                            <StackPanel Margin="12,4,0,4">
                                <Button Content="工程概览"
                                        Command="{Binding OpenDashboardCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="数据"
                                  Style="{StaticResource NavigationExpanderStyle}">
                            <StackPanel Margin="12,4,0,4">
                                <Button Content="线路管理"
                                        Command="{Binding OpenLineManagementCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="仪器导入"
                                        Command="{Binding OpenInstrumentImportCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="原始观测"
                                        Command="{Binding OpenRawObservationsCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="高差观测"
                                        Command="{Binding OpenLevelDifferencesCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="已知高程"
                                        Command="{Binding OpenKnownHeightsCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="网形草图"
                                        Command="{Binding OpenMapSketchCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="计算"
                                  Style="{StaticResource NavigationExpanderStyle}">
                            <StackPanel Margin="12,4,0,4">
                                <Button Content="搜索路线"
                                        Command="{Binding SearchRoutesCommand}"
                                        ToolTip="搜索闭合/附合路线"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="闭合/附合路线"
                                        Command="{Binding OpenRoutesCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="高程平差"
                                        Command="{Binding CalculateAdjustmentCommand}"
                                        ToolTip="执行高程平差计算"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="平差结果"
                                        Command="{Binding OpenAdjustmentResultsCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="水准网图"
                                        Command="{Binding OpenNetworkGraphCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                                <Button Content="报告与导出"
                                        Command="{Binding OpenReportCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="项目"
                                  Style="{StaticResource NavigationExpanderStyle}">
                            <StackPanel Margin="12,4,0,4">
                                <Button Content="工程设置"
                                        Command="{Binding OpenProjectSettingsCommand}"
                                        Style="{StaticResource NavigationButtonStyle}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding SelectedTab}"/>
        </Grid>
    </DockPanel>
</Window>

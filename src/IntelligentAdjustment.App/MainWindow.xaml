<Window x:Class="IntelligentAdjustment.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/IntelligentAdjustment.ico"
        Width="1380"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="MainToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Width" Value="92"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MainToolbarLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource AppSurfaceBrush}"
              Foreground="{DynamicResource AppPrimaryTextBrush}">
            <MenuItem Header="{DynamicResource Loc.Menu.File}">
                <MenuItem Header="{DynamicResource Loc.Menu.NewProject}" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{DynamicResource Loc.Menu.OpenProject}" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Loc.Menu.SaveProject}" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="{DynamicResource Loc.Menu.SaveAs}" Command="{Binding SaveProjectAsCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Menu.CloseProject}" Command="{Binding CloseProjectCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Loc.Menu.InstrumentImport}" Command="{Binding OpenInstrumentImportCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Menu.ImportOut}" Command="{Binding ImportOutCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Loc.Menu.ReportExport}" Command="{Binding OpenReportCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Loc.Menu.Exit}" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Edit}">
                <MenuItem Header="{DynamicResource Loc.Menu.Undo}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="{DynamicResource Loc.Menu.Redo}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Calculate}">
                <MenuItem Header="{DynamicResource Loc.Menu.SearchRoutes}" Command="{Binding SearchRoutesCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Menu.RunAdjustment}" Command="{Binding CalculateAdjustmentCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.View}">
                <MenuItem Header="{DynamicResource Loc.Nav.Dashboard}" Command="{Binding OpenDashboardCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Nav.Lines}" Command="{Binding OpenLineManagementCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Nav.RawObservations}" Command="{Binding OpenRawObservationsCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Nav.Differences}" Command="{Binding OpenLevelDifferencesCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Nav.KnownHeights}" Command="{Binding OpenKnownHeightsCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Nav.MapSketch}" Command="{Binding OpenMapSketchCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Nav.NetworkGraph}" Command="{Binding OpenNetworkGraphCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Nav.AdjustmentResults}" Command="{Binding OpenAdjustmentResultsCommand}"/>
                <MenuItem Header="{DynamicResource Loc.Nav.Report}" Command="{Binding OpenReportCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Tools}">
                <MenuItem Header="{DynamicResource Loc.Nav.ProjectSettings}" Command="{Binding OpenProjectSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Help}">
                <MenuItem Header="{DynamicResource Loc.Menu.About}" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Plain toolbar surface instead of WPF ToolBar: no grip and no overflow triangle. -->
        <Border DockPanel.Dock="Top"
                Background="Transparent"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5,8,6">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NewProjectCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.NewProject}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AppAccentSoftBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M12,3 L12,21 M3,12 L21,12"
                                      Stroke="{DynamicResource AppAccentBrush}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.New}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenProjectCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.OpenProject}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AppOrangeSoftBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="19" Height="19">
                                <Path Data="M3,7 L9,7 L11,10 L22,10 L20,20 L3,20 Z"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AppOrangeBrush}"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.Open}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding SaveProjectCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.SaveProject}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AppTealSoftBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M4,3 L18,3 L21,6 L21,21 L3,21 L3,3 Z M7,3 L7,9 L17,9 L17,3 M7,14 L17,14 L17,20 L7,20 Z"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AppTealBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.Save}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="44" Margin="8,10" Background="{DynamicResource AppBorderBrush}"/>

                <Button Command="{Binding UndoCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.Undo}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AppPurpleSoftBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="19" Height="19">
                                <Path Data="M10,6 L5,10 L10,14 M6,10 L14,10 C18,10 20,13 20,17"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AppPurpleBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.Undo}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding RedoCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.Redo}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AppPurpleSoftBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="19" Height="19">
                                <Path Data="M14,6 L19,10 L14,14 M18,10 L10,10 C6,10 4,13 4,17"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AppPurpleBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.Redo}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="44" Margin="8,10" Background="{DynamicResource AppBorderBrush}"/>

                <Button Command="{Binding OpenInstrumentImportCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.InstrumentImport}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AppSuccessSoftBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="19" Height="19">
                                <Path Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,19 L20,19"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AppSuccessBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.InstrumentImport}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ImportOutCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.ImportOut}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AppAccentSoftBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="19" Height="19">
                                <Path Data="M12,3 L12,14 M8,10 L12,14 L16,10 M5,18 L19,18 M5,21 L19,21"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AppAccentBrush}"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.ImportOut}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="44" Margin="8,10" Background="{DynamicResource AppBorderBrush}"/>

                <Button Command="{Binding OpenProjectSettingsCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.Settings}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32"
                                Height="32"
                                CornerRadius="9"
                                Background="{DynamicResource AppPurpleSoftBrush}"
                                HorizontalAlignment="Center">
                            <Viewbox Width="19" Height="19">
                                <Path Data="M12,3 A2,2 0 0 1 14,5 L14.5,6.5 L16,7.2 L17.5,6.7 A2,2 0 0 1 20,9.2 L19.3,10.7 L20,12 L21.5,12.5 A2,2 0 0 1 21.5,15.5 L20,16 L19.3,17.3 L20,18.8 A2,2 0 0 1 17.5,21.3 L16,20.8 L14.5,21.5 L14,23 A2,2 0 0 1 10,23 L9.5,21.5 L8,20.8 L6.5,21.3 A2,2 0 0 1 4,18.8 L4.7,17.3 L4,16 L2.5,15.5 A2,2 0 0 1 2.5,12.5 L4,12 L4.7,10.7 L4,9.2 A2,2 0 0 1 6.5,6.7 L8,7.2 L9.5,6.5 L10,5 A2,2 0 0 1 12,3 Z M12,10 A4,4 0 1 0 12,18 A4,4 0 1 0 12,10 Z"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AppPurpleBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.Settings}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding AboutCommand}"
                        ToolTip="{DynamicResource Loc.Tooltip.About}"
                        Style="{StaticResource MainToolbarButtonStyle}">
                    <StackPanel>
                        <Border Width="32"
                                Height="32"
                                CornerRadius="9"
                                Background="{DynamicResource AppTealSoftBrush}"
                                HorizontalAlignment="Center">
                            <Viewbox Width="19" Height="19">
                                <Grid Width="24" Height="24">
                                    <Ellipse Stroke="{DynamicResource AppTealBrush}"
                                             StrokeThickness="2"
                                             Fill="Transparent"/>
                                    <TextBlock Text="i"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTealBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-1,0,0"/>
                                </Grid>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{DynamicResource Loc.Toolbar.About}" Style="{StaticResource MainToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource AppSurfaceBrush}"
                   Foreground="{DynamicResource AppSecondaryTextBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentProjectPathDisplay}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="90" Height="10" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Background="{DynamicResource AppPageBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource AppSidebarBrush}">
                <Border.Resources>
                    <Style TargetType="Expander"
                           BasedOn="{StaticResource Expander.Small}">
                        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Margin" Value="0,5,0,5"/>
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                    </Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource ButtonDefault}">
                        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
                        <Setter Property="MinHeight" Value="42"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                        <Binding Path="DataContext.SelectedTab.Key"
                                                 RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                        <Binding Path="Tag"
                                                 RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8">
                        <Expander Header="{DynamicResource Loc.Nav.Project}">
                            <StackPanel Margin="8,4,8,8">
                                <Button Tag="dashboard" Content="{DynamicResource Loc.Nav.Dashboard}" Command="{Binding OpenDashboardCommand}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{DynamicResource Loc.Nav.Data}">
                            <StackPanel Margin="8,4,8,8">
                                <Button Tag="lines" Content="{DynamicResource Loc.Nav.Lines}" Command="{Binding OpenLineManagementCommand}"/>
                                <Button Tag="instrument-import" Content="{DynamicResource Loc.Nav.InstrumentImport}" Command="{Binding OpenInstrumentImportCommand}"/>
                                <Button Tag="raw-observations" Content="{DynamicResource Loc.Nav.RawObservations}" Command="{Binding OpenRawObservationsCommand}"/>
                                <Button Tag="differences" Content="{DynamicResource Loc.Nav.Differences}" Command="{Binding OpenLevelDifferencesCommand}"/>
                                <Button Tag="known-heights" Content="{DynamicResource Loc.Nav.KnownHeights}" Command="{Binding OpenKnownHeightsCommand}"/>
                                <Button Tag="map-sketch" Content="{DynamicResource Loc.Nav.MapSketch}" Command="{Binding OpenMapSketchCommand}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{DynamicResource Loc.Nav.Calculation}">
                            <StackPanel Margin="8,4,8,8">
                                <Button Content="{DynamicResource Loc.Nav.SearchRoutes}"
                                        Command="{Binding SearchRoutesCommand}"
                                        ToolTip="{DynamicResource Loc.Tooltip.SearchRoutes}"/>
                                <Button Tag="routes"
                                        Content="{DynamicResource Loc.Nav.Routes}"
                                        Command="{Binding OpenRoutesCommand}"
                                        ToolTip="{DynamicResource Loc.Tooltip.ViewRoutes}"/>
                                <Button Content="{DynamicResource Loc.Nav.RunAdjustment}"
                                        Command="{Binding CalculateAdjustmentCommand}"
                                        ToolTip="{DynamicResource Loc.Tooltip.RunAdjustment}"/>
                                <Button Tag="adjustment-results"
                                        Content="{DynamicResource Loc.Nav.AdjustmentResults}"
                                        Command="{Binding OpenAdjustmentResultsCommand}"
                                        ToolTip="{DynamicResource Loc.Tooltip.ViewAdjustment}"/>
                                <Button Tag="network-graph" Content="{DynamicResource Loc.Nav.NetworkGraph}" Command="{Binding OpenNetworkGraphCommand}"/>
                                <Button Tag="report" Content="{DynamicResource Loc.Nav.Report}" Command="{Binding OpenReportCommand}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{DynamicResource Loc.Nav.Settings}">
                            <StackPanel Margin="8,4,8,8">
                                <Button Tag="settings" Content="{DynamicResource Loc.Nav.ProjectSettings}" Command="{Binding OpenProjectSettingsCommand}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ContentControl Grid.Column="1"
                            Background="{DynamicResource AppPageBackgroundBrush}"
                            Content="{Binding SelectedTab}"/>
        </Grid>
    </DockPanel>
</Window>

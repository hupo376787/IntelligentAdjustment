<UserControl x:Class="IntelligentAdjustment.App.Views.NetworkGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Padding="10"
                Margin="0,0,0,10"
                BorderBrush="#E1E5EA"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Fit to View"
                        Command="{Binding FitToViewCommand}"
                        Padding="12,5"
                        Margin="0,0,8,0"/>
                <Button Content="导出 PNG"
                        Command="{Binding ExportPngCommand}"
                        Padding="12,5"
                        Margin="0,0,6,0"/>
                <Button Content="导出 SVG"
                        Command="{Binding ExportSvgCommand}"
                        Padding="12,5"
                        Margin="0,0,16,0"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D7DCE2"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    Margin="0,0,10,0">
                <Canvas x:Name="GraphCanvas"
                        Background="White"
                        ClipToBounds="True"
                        Focusable="True"
                        MouseWheel="GraphCanvas_MouseWheel"
                        MouseDown="GraphCanvas_MouseDown"
                        MouseUp="GraphCanvas_MouseUp"
                        MouseMove="GraphCanvas_MouseMove"
                        MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
                        SizeChanged="GraphCanvas_SizeChanged"/>
            </Border>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top"
                           Text="测段联动"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding Edges}"
                          SelectedItem="{Binding SelectedDifference, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="起点" Binding="{Binding FromPoint}" Width="85"/>
                        <DataGridTextColumn Header="终点" Binding="{Binding ToPoint}" Width="85"/>
                        <DataGridTextColumn Header="高差 [m]" Binding="{Binding HeightDifference, StringFormat=F5}" Width="90"/>
                        <DataGridTextColumn Header="距离 [m]" Binding="{Binding DistanceMeters, StringFormat=F1}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

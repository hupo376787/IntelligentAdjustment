<UserControl x:Class="IntelligentAdjustment.App.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppWarningSoftBrush}"
                BorderBrush="{DynamicResource AppWarningBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{DynamicResource Loc.Routes.Stale}"
                       Foreground="{DynamicResource AppWarningTextBrush}"/>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Loc.Routes.Title}" FontSize="{DynamicResource AppSectionTitleFontSize}" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <DataGrid ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  MinRowHeight="52"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="MinHeight" Value="52"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.Sequence}" Binding="{Binding Index}" Width="70"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Routes.Type}" Binding="{Binding RouteType, Converter={StaticResource RouteTypeConverter}}" Width="100"/>
                <DataGridTemplateColumn Header="{DynamicResource Loc.Routes.Route}" Width="2*" MinWidth="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PointPath}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="6,10"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding PointPath}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource Loc.Routes.EdgeCount}" Binding="{Binding EdgeCount}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.DistanceM}" Width="120">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                            <Binding Path="LengthMeters"/>
                            <Binding Path="DataContext.Document.Settings.DistanceDecimals"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                     Mode="OneWay"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.StationCount}" Binding="{Binding StationCount}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Routes.Closure}" Binding="{Binding ClosureMillimeters, StringFormat=F3}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Routes.Tolerance}" Binding="{Binding ActiveToleranceMillimeters, StringFormat=F3}" Width="130"/>
                <DataGridCheckBoxColumn Header="{DynamicResource Loc.Routes.OverLimit}" Binding="{Binding IsOverLimit}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

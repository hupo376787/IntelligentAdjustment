<UserControl x:Class="IntelligentAdjustment.App.Views.LineManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Loc.Line.NewLine}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Margin="8,0,8,0"
                         Text="{Binding NewLineName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2"
                        Content="{DynamicResource Loc.Line.Create}"
                        Command="{Binding CreateCommand}"
                        Padding="14,5"/>

                <TextBlock Grid.Column="4"
                           Text="{DynamicResource Loc.Line.CurrentName}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="5"
                         Margin="8,0,8,0"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="6"
                        Content="{DynamicResource Loc.Line.Rename}"
                        Command="{Binding RenameCommand}"
                        Padding="14,5"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="7"
                        Content="{DynamicResource Loc.Line.MoveUp}"
                        Command="{Binding MoveUpCommand}"
                        Padding="12,5"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="8"
                        Content="{DynamicResource Loc.Line.MoveDown}"
                        Command="{Binding MoveDownCommand}"
                        Padding="12,5"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="9"
                        Content="{DynamicResource Loc.Common.Delete}"
                        Command="{Binding DeleteCommand}"
                        Padding="12,5"/>
            </Grid>
        </Border>

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Loc.Line.Order}" Binding="{Binding DisplayOrder}" Width="70"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Line.Name}" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Line.SourceType}" Binding="{Binding InstrumentType}" Width="130"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.SourceFile}" Binding="{Binding SourceFileName}" Width="220"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Line.RawCount}" Binding="{Binding RawObservationCount}" Width="100"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Line.DifferenceCount}" Binding="{Binding LevelDifferenceCount}" Width="100"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Line.InternalId}" Binding="{Binding Id}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

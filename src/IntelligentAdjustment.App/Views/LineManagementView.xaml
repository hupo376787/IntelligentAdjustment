<UserControl x:Class="IntelligentAdjustment.App.Views.LineManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                BorderBrush="#E1E5EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="新线路" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Margin="8,0,8,0"
                         Text="{Binding NewLineName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2"
                        Content="创建"
                        Command="{Binding CreateCommand}"
                        Padding="14,5"/>

                <TextBlock Grid.Column="4"
                           Text="当前名称"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="5"
                         Margin="8,0,8,0"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="6"
                        Content="重命名"
                        Command="{Binding RenameCommand}"
                        Padding="14,5"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="7"
                        Content="上移"
                        Command="{Binding MoveUpCommand}"
                        Padding="12,5"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="8"
                        Content="下移"
                        Command="{Binding MoveDownCommand}"
                        Padding="12,5"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="9"
                        Content="删除"
                        Command="{Binding DeleteCommand}"
                        Padding="12,5"/>
            </Grid>
        </Border>

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="顺序" Binding="{Binding DisplayOrder}" Width="70"/>
                <DataGridTextColumn Header="线路名称" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="来源类型" Binding="{Binding InstrumentType}" Width="130"/>
                <DataGridTextColumn Header="源文件" Binding="{Binding SourceFileName}" Width="220"/>
                <DataGridTextColumn Header="原始观测" Binding="{Binding RawObservationCount}" Width="100"/>
                <DataGridTextColumn Header="高差观测" Binding="{Binding LevelDifferenceCount}" Width="100"/>
                <DataGridTextColumn Header="内部 ID" Binding="{Binding Id}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<UserControl x:Class="IntelligentAdjustment.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource Loc.Report.ExportDocx}"
                            Command="{Binding ExportDocxCommand}"
                            Padding="14,5"
                            Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Loc.Report.ExportXlsx}"
                            Command="{Binding ExportXlsxCommand}"
                            Padding="14,5"
                            Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Loc.Report.ExportTxt}"
                            Command="{Binding ExportTextCommand}"
                            Padding="14,5"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Report.Title}"
                               FontSize="{DynamicResource AppSectionTitleFontSize}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                <Expander Header="{DynamicResource Loc.Report.Section1}" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="14,10,4,12">
                        <TextBlock Text="{DynamicResource Loc.Report.Section11}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.TaskOverview, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Loc.Report.Section12}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.NaturalGeography, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource Loc.Report.Section2}" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="14,10,4,12">
                        <TextBlock Text="{DynamicResource Loc.Report.Section21}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.ExistingData, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Loc.Report.Section22}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.ReferencedStandards, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Loc.Report.Section23}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.TechnicalIndicators, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource Loc.Report.Section24}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.FieldWorkSummary, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"/>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource Loc.Report.Section3}" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="14,10,4,12">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}">
                            导出时自动生成 3.1 控制网精度评定、3.2 闭合线路统计、3.3 已知点成果、3.4 高差观测值成果、3.5 测段高差中误差及残差、3.6 高程成果。
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource Loc.Report.Section4}" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="14,10,4,12">
                        <TextBox Text="{Binding Document.ConclusionAndRecommendations, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="140"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

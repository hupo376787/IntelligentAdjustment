<UserControl x:Class="IntelligentAdjustment.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                BorderBrush="#E1E5EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="导出 DOCX"
                            Command="{Binding ExportDocxCommand}"
                            Padding="14,5"
                            Margin="0,0,6,0"/>
                    <Button Content="导出 XLSX"
                            Command="{Binding ExportXlsxCommand}"
                            Padding="14,5"
                            Margin="0,0,6,0"/>
                    <Button Content="导出 TXT"
                            Command="{Binding ExportTextCommand}"
                            Padding="14,5"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="报告与成果导出"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                <Border Background="#F8FAFC"
                        BorderBrush="#D9E1EA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="#4B5563"
                               Text="报告章节沿用原软件 Report.doc 的专业结构：项目概述、高程控制测量、高程控制网平差、结论和建议。引用标准与结论由用户按项目实际填写；软件不会自动生成无法由计算结果验证的检查验收结论。"/>
                </Border>

                <Expander Header="1 项目概述" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="14,10,4,12">
                        <TextBlock Text="1.1 任务概述" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.TaskOverview, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="1.2 测区自然地理情况" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.NaturalGeography, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"/>
                    </StackPanel>
                </Expander>

                <Expander Header="2 高程控制测量" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="14,10,4,12">
                        <TextBlock Text="2.1 已有资料情况" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.ExistingData, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="2.2 引用文件 / 标准规范" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.ReferencedStandards, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="2.3 主要技术指标" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.TechnicalIndicators, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="2.4 外业完成的工作量" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Document.FieldWorkSummary, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"/>
                    </StackPanel>
                </Expander>

                <Expander Header="3 高程控制网平差（自动生成）" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="14,10,4,12">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#4B5563">
                            导出时自动生成 3.1 控制网精度评定、3.2 闭合线路统计、3.3 已知点成果、3.4 高差观测值成果、3.5 测段高差中误差及残差、3.6 高程成果。
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <Expander Header="4 结论和建议" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="14,10,4,12">
                        <TextBox Text="{Binding Document.ConclusionAndRecommendations, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="140"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

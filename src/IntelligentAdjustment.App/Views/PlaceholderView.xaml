<UserControl x:Class="IntelligentAdjustment.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
            <TextBlock Text="{Binding Header}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="14" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

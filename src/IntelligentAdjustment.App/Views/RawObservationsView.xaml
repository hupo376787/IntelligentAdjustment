<UserControl x:Class="IntelligentAdjustment.App.Views.RawObservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:IntelligentAdjustment.Domain;assembly=IntelligentAdjustment.Domain"
             xmlns:behaviors="clr-namespace:IntelligentAdjustment.App.Behaviors">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                BorderBrush="#E1E5EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="线路" VerticalAlignment="Center"/>
                <ComboBox Width="220"
                          Margin="8,0,12,0"
                          ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>
                <Button Content="新增测站"
                        Command="{Binding AddCommand}"
                        Padding="12,5"
                        Margin="0,0,6,0"/>
                <Button Content="删除选中"
                        Command="{Binding DeleteSelectedCommand}"
                        Padding="12,5"
                        Margin="0,0,12,0"/>
                <Separator Width="10"/>
                <Button Content="生成/更新高差"
                        Command="{Binding GenerateDifferencesCommand}"
                        Padding="14,5"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="2,8,0,0"
                   Foreground="#6B7280"
                   Text="原始观测修改后，如工程设置启用了“自动更新高差”，提交影响高差的单元格时会询问是否立即重新计算当前线路。"/>

        <DataGrid x:Name="RawGrid"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  FrozenColumnCount="3"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  ClipboardCopyMode="ExcludeHeader"
                  CellEditEnding="RawGrid_CellEditEnding"
                  PreviewKeyDown="RawGrid_PreviewKeyDown"
                  behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedRows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号"
                                    Binding="{Binding Sequence}"
                                    IsReadOnly="True"
                                    Width="60"/>
                <DataGridTextColumn Header="起点"
                                    Binding="{Binding FromPoint, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="105"/>
                <DataGridTextColumn Header="终点"
                                    Binding="{Binding ToPoint, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="105"/>

                <DataGridTextColumn Header="B1"
                                    Binding="{Binding B1, UpdateSourceTrigger=LostFocus, StringFormat=F5, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTextColumn Header="B2"
                                    Binding="{Binding B2, UpdateSourceTrigger=LostFocus, StringFormat=F5, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTextColumn Header="F1"
                                    Binding="{Binding F1, UpdateSourceTrigger=LostFocus, StringFormat=F5, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTextColumn Header="F2"
                                    Binding="{Binding F2, UpdateSourceTrigger=LostFocus, StringFormat=F5, ValidatesOnDataErrors=True}"
                                    Width="90"/>

                <DataGridTextColumn Header="后距1"
                                    Binding="{Binding DistanceB1, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTextColumn Header="后距2"
                                    Binding="{Binding DistanceB2, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTextColumn Header="前距1"
                                    Binding="{Binding DistanceF1, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTextColumn Header="前距2"
                                    Binding="{Binding DistanceF2, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnDataErrors=True}"
                                    Width="90"/>

                <DataGridTemplateColumn Header="测量模式" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MeasurementMode}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding MeasurementMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="BF" Tag="{x:Static domain:MeasurementMode.BF}"/>
                                <ComboBoxItem Content="BFFB" Tag="{x:Static domain:MeasurementMode.BFFB}"/>
                                <ComboBoxItem Content="aBF" Tag="{x:Static domain:MeasurementMode.AlternatingBF}"/>
                                <ComboBoxItem Content="aBFFB" Tag="{x:Static domain:MeasurementMode.AlternatingBFFB}"/>
                                <ComboBoxItem Content="BBFF" Tag="{x:Static domain:MeasurementMode.BBFF}"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="观测顺序" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ObservationOrder}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding ObservationOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="BF" Tag="{x:Static domain:ObservationOrder.BF}"/>
                                <ComboBoxItem Content="FB" Tag="{x:Static domain:ObservationOrder.FB}"/>
                                <ComboBoxItem Content="BFFB" Tag="{x:Static domain:ObservationOrder.BFFB}"/>
                                <ComboBoxItem Content="FBBF" Tag="{x:Static domain:ObservationOrder.FBBF}"/>
                                <ComboBoxItem Content="BBFF" Tag="{x:Static domain:ObservationOrder.BBFF}"/>
                                <ComboBoxItem Content="FFBB" Tag="{x:Static domain:ObservationOrder.FFBB}"/>
                                <ComboBoxItem Content="BFBF" Tag="{x:Static domain:ObservationOrder.BFBF}"/>
                                <ComboBoxItem Content="FBFB" Tag="{x:Static domain:ObservationOrder.FBFB}"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridCheckBoxColumn Header="有效"
                                        Binding="{Binding IsValid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="65"/>
                <DataGridTextColumn Header="无效原因"
                                    Binding="{Binding InvalidReason, UpdateSourceTrigger=LostFocus}"
                                    Width="150"/>
                <DataGridTextColumn Header="测量时间"
                                    Binding="{Binding MeasuredAt, UpdateSourceTrigger=LostFocus, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                    Width="155"/>
                <DataGridTextColumn Header="温度 [℃]"
                                    Binding="{Binding TemperatureCelsius, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTextColumn Header="源文件"
                                    Binding="{Binding SourceFileName}"
                                    IsReadOnly="True"
                                    Width="160"/>
                <DataGridTextColumn Header="备注"
                                    Binding="{Binding Comment, UpdateSourceTrigger=LostFocus}"
                                    Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

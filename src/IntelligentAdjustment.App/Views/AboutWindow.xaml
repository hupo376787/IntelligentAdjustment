<hc:Window x:Class="IntelligentAdjustment.App.Views.AboutWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="关于 IntelligentAdjustment"
           ShowTitle="True"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterOwner"
           Width="540"
           Height="430">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="78"
                    Height="78"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="18">
                <Canvas Width="52" Height="52">
                    <Line X1="9" Y1="38" X2="23" Y2="15"
                          Stroke="White" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="23" Y1="15" X2="42" Y2="31"
                          Stroke="White" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="9" Y1="38" X2="42" Y2="31"
                          Stroke="White" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                    <Ellipse Width="12" Height="12"
                             Canvas.Left="3" Canvas.Top="32"
                             Fill="White"/>
                    <Ellipse Width="12" Height="12"
                             Canvas.Left="17" Canvas.Top="9"
                             Fill="White"/>
                    <Rectangle Width="12" Height="12"
                               Canvas.Left="36" Canvas.Top="25"
                               RadiusX="2" RadiusY="2"
                               Fill="White"/>
                </Canvas>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="IntelligentAdjustment"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding VersionText}"
                           Margin="0,7,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource ThirdlyTextBrush}"/>
                <TextBlock Text="高程控制网平差与成果分析"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,16"
                Background="{DynamicResource SecondaryRegionBrush}"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="让高程平差更清晰、更可靠"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Text="从观测数据、路线检核到平差计算与成果输出，让高程控制网处理过程更直观、更一致。"
                           Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="技术框架"
                       Foreground="{DynamicResource ThirdlyTextBrush}"/>
            <TextBlock Grid.Column="1"
                       Text=".NET 8 · WPF · HandyControl"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Grid.Row="2"
                       Text="工程格式"
                       Foreground="{DynamicResource ThirdlyTextBrush}"/>
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="单文件 .iap · SQLite"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Grid.Row="4"
                       Text="产品定位"
                       Foreground="{DynamicResource ThirdlyTextBrush}"/>
            <TextBlock Grid.Row="4"
                       Grid.Column="1"
                       Text="高程控制网数据处理、平差计算与成果输出"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Grid>

        <TextBlock Grid.Row="5"
                   Text="{Binding CopyrightText}"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource ThirdlyTextBrush}"/>

        <Button Grid.Row="6"
                Width="96"
                Height="34"
                Margin="0,18,0,0"
                HorizontalAlignment="Center"
                IsDefault="True"
                IsCancel="True"
                Content="确定"
                Style="{StaticResource ButtonPrimary}"
                Click="CloseButton_Click"/>
    </Grid>
</hc:Window>

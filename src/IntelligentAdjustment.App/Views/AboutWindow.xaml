<hc:Window x:Class="IntelligentAdjustment.App.Views.AboutWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="关于 IntelligentAdjustment"
           Icon="pack://application:,,,/IntelligentAdjustment.App;component/Assets/IntelligentAdjustment.ico"
           ShowTitle="True"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterOwner"
           Background="{DynamicResource AppPageBackgroundBrush}"
           FontSize="{DynamicResource AppFontSize}"
           Width="560"
           SizeToContent="Height">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ContentControl Width="80"
                            Height="80"
                            HorizontalAlignment="Left"
                            Template="{StaticResource AppLogoTemplate}"/>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="IntelligentAdjustment"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                <TextBlock Text="{Binding VersionText}"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                <TextBlock Text="高程控制网平差与成果分析"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="18,16"
                Background="{DynamicResource AppAccentSoftBrush}">
            <StackPanel>
                <TextBlock Text="From data to certainty."
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppAccentBrush}"/>
                <TextBlock Text="从观测数据、路线检核到平差计算与成果输出，让高程控制网处理过程更直观、更一致。"
                           Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding CopyrightText}"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AppMutedTextBrush}"/>

        <Button Grid.Row="4"
                MinWidth="110"
                MinHeight="42"
                Margin="0,16,0,0"
                Padding="20,8"
                HorizontalAlignment="Center"
                IsDefault="True"
                IsCancel="True"
                Content="确定"
                Style="{StaticResource ButtonPrimary}"
                Click="CloseButton_Click"/>
    </Grid>
</hc:Window>

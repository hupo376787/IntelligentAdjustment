<UserControl x:Class="IntelligentAdjustment.App.Views.InstrumentImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24"
                    Width="760"
                    HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Loc.Import.Title}"
                       FontSize="{DynamicResource AppPageTitleFontSize}"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Loc.Import.Subtitle}"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       Margin="0,4,0,20"/>

            <GroupBox Header="{DynamicResource Loc.Import.Parser}"
                      Padding="16"
                      Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource Loc.Import.ManufacturerFormat}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Catalog}"
                              SelectedItem="{Binding SelectedImporter, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="3"
                               Text="{Binding SupportText}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource Loc.Import.Files}"
                      Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Loc.Import.SelectFiles}"
                                Command="{Binding ChooseFilesCommand}"
                                Padding="14,5"
                                Margin="0,0,12,0"/>
                        <Button Content="{DynamicResource Loc.Import.Start}"
                                Command="{Binding ImportCommand}"
                                Padding="18,5"/>
                        <TextBlock Text="{Binding FileSummary}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Margin="16,0,0,0"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding SelectedFiles}"
                             Height="220"
                             Margin="0,14,0,0"/>
                </StackPanel>
            </GroupBox>

            <Border Margin="0,16,0,0"
                    Padding="12"
                    CornerRadius="6"
                    Background="{DynamicResource AppSurfaceAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSecondaryTextBrush}">
                    已按原程序随附 Sample 文件与使用手册接入 Leica DNA（GSI/MDT）、GeoMax ZDL（MDT）、Sokkia SDL（CSV）、Topcon DL（DAT）、Trimble DiNi（DAT）、Lev_Net（OUT/MDT）以及通用高差 OUT。多选文件时默认一文件一线路，并保留原始文件字节与 SHA-256。
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

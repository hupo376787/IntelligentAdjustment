<Window x:Class="IntelligentAdjustment.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Border Margin="18"
            Padding="34"
            CornerRadius="22"
            Background="{DynamicResource AppSurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.22"
                              Color="#334155"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Width="76"
                                Height="76"
                                HorizontalAlignment="Left"
                                Template="{StaticResource AppLogoTemplate}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="IntelligentAdjustment"
                               FontSize="29"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                    <TextBlock Text="{DynamicResource Loc.App.ProductSubtitle}"
                               Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource Loc.App.Slogan}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppAccentBrush}"/>
                <TextBlock Text="{DynamicResource Loc.App.SloganDescription}"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource AppMutedTextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="WorkItemText"
                               Text="{DynamicResource Loc.Splash.Starting}"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    <TextBlock x:Name="PercentText"
                               HorizontalAlignment="Right"
                               Text="0%"
                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                </Grid>
                <ProgressBar x:Name="StartupProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Style="{StaticResource ProgressBarInfo}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

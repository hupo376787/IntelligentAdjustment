<UserControl x:Class="IntelligentAdjustment.App.Views.LevelDifferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:IntelligentAdjustment.Domain;assembly=IntelligentAdjustment.Domain"
             xmlns:behaviors="clr-namespace:IntelligentAdjustment.App.Behaviors">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="新增一行" Command="{Binding AddCommand}" Padding="12,5" Margin="0,0,6,0"/>
            <Button Content="删除选中" Command="{Binding DeleteSelectedCommand}" Padding="12,5" Margin="0,0,12,0"/>

            <Separator Width="10"/>

            <Button Content="合并测站"
                    Command="{Binding TogglePointRoleCommand}"
                    ToolTip="切换选中测站的“平差点/过渡点”状态"
                    Padding="12,5"
                    Margin="0,0,6,0"/>
            <Button Content="自动合并"
                    Command="{Binding AutoDetectTransitionPointsCommand}"
                    ToolTip="自动识别符合规则的过渡点；不会立即删除数据"
                    Padding="12,5"
                    Margin="0,0,6,0"/>
            <Button Content="合并后删除"
                    Command="{Binding MergeSelectedAndDeleteCommand}"
                    ToolTip="将选中测站纳入合并关系并立即压缩、删除中间过渡点"
                    Padding="12,5"
                    Margin="0,0,6,0"/>
            <Button Content="删除过渡点"
                    Command="{Binding DeleteTransitionPointsCommand}"
                    ToolTip="压缩当前工程中已经标记的过渡点，与当前选区无关"
                    Padding="12,5"/>

            <Separator Width="10"/>

            <Button Content="设为平差点" Command="{Binding SetAdjustmentPointCommand}" Padding="12,5" Margin="0,0,6,0"/>
            <Button Content="设为过渡点" Command="{Binding SetTransitionPointCommand}" Padding="12,5"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="2,8,0,0"
                   Foreground="#6B7280"
                   Text="提示：Ctrl+C 复制选中行；Ctrl+V 可粘贴 5 列“起点、终点、高差、距离、测站数”或本表复制的整行数据。Enter 向下移动，Tab 横向移动。"/>

        <DataGrid x:Name="DifferenceGrid"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="All"
                  ClipboardCopyMode="ExcludeHeader"
                  PreviewKeyDown="DifferenceGrid_PreviewKeyDown"
                  behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedRows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="起点点名"
                                    Binding="{Binding FromPoint, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="120"/>
                <DataGridTextColumn Header="终点点名"
                                    Binding="{Binding ToPoint, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="120"/>
                <DataGridTextColumn Header="高差 [m]" Width="120">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="TwoWay">
                            <Binding Path="HeightDifference" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True"/>
                            <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                     Mode="OneWay"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="距离 [m]" Width="120">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="TwoWay">
                            <Binding Path="DistanceMeters" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True"/>
                            <Binding Path="DataContext.Document.Settings.DistanceDecimals"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                     Mode="OneWay"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="测站数"
                                    Binding="{Binding StationCount, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTemplateColumn Header="平差类型" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ToPointRole, Converter={StaticResource PointRoleConverter}}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding ToPointRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="平差点" Tag="{x:Static domain:PointRole.AdjustmentPoint}"/>
                                <ComboBoxItem Content="过渡点" Tag="{x:Static domain:PointRole.TransitionPoint}"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="线路" Binding="{Binding LineId}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Comment, UpdateSourceTrigger=LostFocus}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="删除选中行" Command="{Binding DeleteSelectedCommand}"/>
                    <Separator/>
                    <MenuItem Header="合并测站（切换平差类型）" Command="{Binding TogglePointRoleCommand}"/>
                    <MenuItem Header="自动合并（自动识别过渡点）" Command="{Binding AutoDetectTransitionPointsCommand}"/>
                    <MenuItem Header="合并后删除" Command="{Binding MergeSelectedAndDeleteCommand}"/>
                    <MenuItem Header="删除过渡点" Command="{Binding DeleteTransitionPointsCommand}"/>
                    <Separator/>
                    <MenuItem Header="设为平差点" Command="{Binding SetAdjustmentPointCommand}"/>
                    <MenuItem Header="设为过渡点" Command="{Binding SetTransitionPointCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</UserControl>

<UserControl x:Class="IntelligentAdjustment.App.Views.LevelDifferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:IntelligentAdjustment.Domain;assembly=IntelligentAdjustment.Domain"
             xmlns:behaviors="clr-namespace:IntelligentAdjustment.App.Behaviors">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource Loc.Diff.AddRow}" Command="{Binding AddCommand}" Padding="12,5" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Loc.Common.DeleteSelected}" Command="{Binding DeleteSelectedCommand}" Padding="12,5" Margin="0,0,12,0"/>

            <Separator Width="10"/>

            <Button Content="{DynamicResource Loc.Diff.MergeStations}"
                    Command="{Binding TogglePointRoleCommand}"
                    ToolTip="{DynamicResource Loc.Diff.ToggleRoleTip}"
                    Padding="12,5"
                    Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Loc.Diff.AutoMerge}"
                    Command="{Binding AutoDetectTransitionPointsCommand}"
                    ToolTip="{DynamicResource Loc.Diff.AutoMergeTip}"
                    Padding="12,5"
                    Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Loc.Diff.MergeDelete}"
                    Command="{Binding MergeSelectedAndDeleteCommand}"
                    ToolTip="{DynamicResource Loc.Diff.MergeDeleteTip}"
                    Padding="12,5"
                    Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Loc.Diff.DeleteTransition}"
                    Command="{Binding DeleteTransitionPointsCommand}"
                    ToolTip="{DynamicResource Loc.Diff.DeleteTransitionTip}"
                    Padding="12,5"/>

            <Separator Width="10"/>

            <Button Content="{DynamicResource Loc.Diff.SetAdjustment}" Command="{Binding SetAdjustmentPointCommand}" Padding="12,5" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Loc.Diff.SetTransition}" Command="{Binding SetTransitionPointCommand}" Padding="12,5"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="2,8,0,0"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   Text="{DynamicResource Loc.Diff.Hint}"/>

        <DataGrid x:Name="DifferenceGrid"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource AppBorderBrush}"
                  HeadersVisibility="All"
                  ClipboardCopyMode="ExcludeHeader"
                  PreviewKeyDown="DifferenceGrid_PreviewKeyDown"
                  behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedRows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.Sequence}" Binding="{Binding Sequence}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Diff.FromPoint}"
                                    Binding="{Binding FromPoint, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="120"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Diff.ToPoint}"
                                    Binding="{Binding ToPoint, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="120"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.HeightDifferenceM}" Width="120">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="TwoWay" UpdateSourceTrigger="LostFocus">
                            <Binding Path="HeightDifference" Mode="TwoWay" ValidatesOnDataErrors="True"/>
                            <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                     Mode="OneWay"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.DistanceM}" Width="120">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="TwoWay" UpdateSourceTrigger="LostFocus">
                            <Binding Path="DistanceMeters" Mode="TwoWay" ValidatesOnDataErrors="True"/>
                            <Binding Path="DataContext.Document.Settings.DistanceDecimals"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                     Mode="OneWay"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.StationCount}"
                                    Binding="{Binding StationCount, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="90"/>
                <DataGridTemplateColumn Header="{DynamicResource Loc.Diff.Role}" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ToPointRole, Converter={StaticResource PointRoleConverter}}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding ToPointRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="{DynamicResource Loc.Role.Adjustment}" Tag="{x:Static domain:PointRole.AdjustmentPoint}"/>
                                <ComboBoxItem Content="{DynamicResource Loc.Role.Transition}" Tag="{x:Static domain:PointRole.TransitionPoint}"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource Loc.Diff.Line}" Binding="{Binding LineName}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource Loc.Common.Remarks}" Binding="{Binding Comment, UpdateSourceTrigger=LostFocus}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{DynamicResource Loc.Common.DeleteSelected}" Command="{Binding DeleteSelectedCommand}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Loc.Diff.MergeStations}" Command="{Binding TogglePointRoleCommand}"/>
                    <MenuItem Header="{DynamicResource Loc.Diff.AutoMerge}" Command="{Binding AutoDetectTransitionPointsCommand}"/>
                    <MenuItem Header="{DynamicResource Loc.Diff.MergeDelete}" Command="{Binding MergeSelectedAndDeleteCommand}"/>
                    <MenuItem Header="{DynamicResource Loc.Diff.DeleteTransition}" Command="{Binding DeleteTransitionPointsCommand}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Loc.Diff.SetAdjustment}" Command="{Binding SetAdjustmentPointCommand}"/>
                    <MenuItem Header="{DynamicResource Loc.Diff.SetTransition}" Command="{Binding SetTransitionPointCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</UserControl>

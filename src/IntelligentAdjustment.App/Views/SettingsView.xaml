<UserControl x:Class="IntelligentAdjustment.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28"
              MaxWidth="1180"
              HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource Loc.Settings.Title}"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Grid.Row="1"
                       Text="{DynamicResource Loc.Settings.Subtitle}"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="390"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="390"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <GroupBox Header="{DynamicResource Loc.Settings.Interface}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Loc.Settings.Language}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LanguageOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Code"
                                          SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Loc.Settings.LanguageHint}"
                                       Margin="0,0,0,14"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Loc.Settings.FontSize}"
                                           VerticalAlignment="Center"/>
                                <Slider Grid.Column="1"
                                        Minimum="11"
                                        Maximum="18"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding UiFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="8,0,14,0"
                                        VerticalAlignment="Center"/>
                                <Border Grid.Column="2"
                                        Padding="8,5"
                                        Background="{DynamicResource AppAccentSoftBrush}"
                                        CornerRadius="6">
                                    <TextBlock Text="{Binding UiFontSize, StringFormat={}{0:F1} pt}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppAccentBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{DynamicResource Loc.Settings.FontHint}"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Loc.Settings.Tolerance}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Content="{DynamicResource Loc.Settings.ByDistance}"
                                             IsChecked="{Binding IsDistanceTolerance}"
                                             VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Margin="6,0"
                                         Text="{Binding DistanceToleranceCoefficientMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{DynamicResource Loc.Settings.DistanceFormula}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Content="{DynamicResource Loc.Settings.ByStations}"
                                             IsChecked="{Binding IsStationTolerance}"
                                             VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Margin="6,0"
                                         Text="{Binding StationToleranceCoefficientMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2"
                                           Text="mm · √n"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Loc.Settings.Data}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Content="{DynamicResource Loc.Settings.AutoMerge}"
                                      IsChecked="{Binding AutoMergeTransitionPoints}"
                                      Margin="0,3"/>
                            <CheckBox Content="{DynamicResource Loc.Settings.PromptUpdate}"
                                      IsChecked="{Binding AutoUpdateLevelDifferences}"
                                      Margin="0,8,0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Loc.Settings.Startup}" Padding="18" Margin="0,0,0,14">
                        <CheckBox Content="{DynamicResource Loc.Settings.OpenLast}"
                                  IsChecked="{Binding OpenLastProjectOnStartup}"/>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Loc.Settings.OperationConfirmation}" Padding="18">
                        <CheckBox Content="{DynamicResource Loc.Settings.ConfirmUndoRedo}"
                                  IsChecked="{Binding ConfirmUndoRedo}"/>
                    </GroupBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <GroupBox Header="{DynamicResource Loc.Settings.AdjustmentMethod}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <RadioButton Content="{DynamicResource Loc.Settings.Classical}"
                                         IsChecked="{Binding IsClassical}"
                                         Margin="0,3,0,10"/>
                            <RadioButton Content="{DynamicResource Loc.Settings.QuasiStable}"
                                         IsChecked="{Binding IsQuasiStable}"
                                         Margin="0,0,0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Loc.Settings.Precision}" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource Loc.Settings.DistanceDecimals}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding DistanceDecimals, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource Loc.Settings.DistanceDecimalsHint}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>

                            <TextBlock Grid.Row="2"
                                       Text="{DynamicResource Loc.Settings.HeightDecimals}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding HeightDecimals, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="{DynamicResource Loc.Settings.HeightDecimalsHint}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Loc.Settings.LabelPosition}" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource Loc.Settings.Horizontal}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding HorizontalAlignmentOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedIndex="{Binding PointNameHorizontalAlignmentIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2"
                                       Text="{DynamicResource Loc.Settings.Vertical}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      ItemsSource="{Binding VerticalAlignmentOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedIndex="{Binding PointNameVerticalAlignmentIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Loc.Settings.AppDefaults}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Settings.AppDefaultsHint}"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <Button Content="{DynamicResource Loc.Settings.SaveDefaults}"
                                    Command="{Binding SaveAsApplicationDefaultsCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Margin="0,0,0,8"/>
                            <Button Content="{DynamicResource Loc.Settings.ApplyDefaults}"
                                    Command="{Binding ApplyApplicationDefaultsCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

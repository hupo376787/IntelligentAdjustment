<UserControl x:Class="IntelligentAdjustment.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28"
              MaxWidth="1180"
              HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="工程设置"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Grid.Row="1"
                       Text="工程参数随 .iap 保存；界面字体属于应用级设置，并立即生效。"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="390"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="390"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <GroupBox Header="界面显示" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="全局字体大小"
                                           VerticalAlignment="Center"/>
                                <Slider Grid.Column="1"
                                        Minimum="11"
                                        Maximum="18"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding UiFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="8,0,14,0"
                                        VerticalAlignment="Center"/>
                                <Border Grid.Column="2"
                                        Padding="8,5"
                                        Background="{DynamicResource AppAccentSoftBrush}"
                                        CornerRadius="6">
                                    <TextBlock Text="{Binding UiFontSize, StringFormat={}{0:F1} pt}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppAccentBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="拖动后立即应用到主界面、菜单、导航和主要页面。"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="闭合差限差" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Content="限差按距离"
                                             IsChecked="{Binding IsDistanceTolerance}"
                                             VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Margin="6,0"
                                         Text="{Binding DistanceToleranceCoefficientMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2"
                                           Text="mm · √L (L 为 km)"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Content="限差按测站"
                                             IsChecked="{Binding IsStationTolerance}"
                                             VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Margin="6,0"
                                         Text="{Binding StationToleranceCoefficientMm, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2"
                                           Text="mm · √n"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="数据设置" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Content="自动识别/合并过渡点"
                                      IsChecked="{Binding AutoMergeTransitionPoints}"
                                      Margin="0,3"/>
                            <CheckBox Content="更改原始观测值时提示更新高差值"
                                      IsChecked="{Binding AutoUpdateLevelDifferences}"
                                      Margin="0,8,0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="启动" Padding="18">
                        <CheckBox Content="启动 IntelligentAdjustment 时自动打开上次工程"
                                  IsChecked="{Binding OpenLastProjectOnStartup}"/>
                    </GroupBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <GroupBox Header="平差方式" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <RadioButton Content="经典平差方式"
                                         IsChecked="{Binding IsClassical}"
                                         Margin="0,3,0,10"/>
                            <RadioButton Content="拟稳平差方式"
                                         IsChecked="{Binding IsQuasiStable}"
                                         Margin="0,0,0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="显示精度" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="距离小数位" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding DistanceDecimals, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="2"
                                       Text="用于距离显示与导出"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>

                            <TextBlock Grid.Row="2"
                                       Text="高程小数位"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding HeightDecimals, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="用于高差、高程与成果显示"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="网图点名位置" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="水平方向" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding HorizontalAlignmentOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding PointNameHorizontalAlignment, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="2"
                                       Text="垂直方向"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      ItemsSource="{Binding VerticalAlignmentOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding PointNameVerticalAlignment, Mode=TwoWay}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="应用默认设置" Padding="18">
                        <StackPanel>
                            <TextBlock Text="新建工程会套用应用默认设置；当前工程仍保留自己的 .iap 配置。"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <Button Content="保存当前设置为应用默认值"
                                    Command="{Binding SaveAsApplicationDefaultsCommand}"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8"
                                    Margin="0,0,0,8"/>
                            <Button Content="应用默认值到当前工程"
                                    Command="{Binding ApplyApplicationDefaultsCommand}"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

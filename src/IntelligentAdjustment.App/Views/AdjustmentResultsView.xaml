<UserControl x:Class="IntelligentAdjustment.App.Views.AdjustmentResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="#FFF8E1"
                BorderBrush="#F4B400"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="立即更新" Command="{Binding RecalculateCommand}" Padding="12,4"/>
                <TextBlock Text="当前结果基于旧数据，工程数据已发生修改，是否更新？"
                           VerticalAlignment="Center"
                           Foreground="#7A4B00"/>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="14" Margin="0,0,0,10"/>

        <TabControl>
            <TabItem Header="高程成果">
                <DataGrid ItemsSource="{Binding Heights}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="点名" Binding="{Binding PointName}" Width="180"/>
                        <DataGridTextColumn Header="高程 [m]" Width="160">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="Height"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="中误差 [m]" Width="160">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="StandardError"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="基准/已知点" Binding="{Binding IsReferencePoint}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="高差与残差">
                <DataGrid ItemsSource="{Binding Differences}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="起点" Binding="{Binding FromPoint}" Width="120"/>
                        <DataGridTextColumn Header="终点" Binding="{Binding ToPoint}" Width="120"/>
                        <DataGridTextColumn Header="观测高差 [m]" Width="140">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="ObservedDifference"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="平差高差 [m]" Width="140">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="AdjustedDifferenceValue"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="残差 [m]" Width="120">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="Residual"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="距离 [m]" Width="120">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="DistanceMeters"/>
                                    <Binding Path="DataContext.Document.Settings.DistanceDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="测站数" Binding="{Binding StationCount}" Width="90"/>
                        <DataGridTextColumn Header="中误差 [m]" Width="120">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="StandardError"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

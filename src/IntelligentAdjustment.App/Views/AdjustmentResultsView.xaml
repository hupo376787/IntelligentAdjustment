<UserControl x:Class="IntelligentAdjustment.App.Views.AdjustmentResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppWarningSoftBrush}"
                BorderBrush="{DynamicResource AppWarningBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Loc.Adjust.UpdateNow}" Command="{Binding RecalculateCommand}" Padding="12,4"/>
                <TextBlock Text="{DynamicResource Loc.Adjust.Stale}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppWarningTextBrush}"/>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="14" Margin="0,0,0,10"/>

        <TabControl>
            <TabItem Header="{DynamicResource Loc.Adjust.Heights}">
                <DataGrid ItemsSource="{Binding Heights}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc.Known.PointName}" Binding="{Binding PointName}" Width="180"/>
                        <DataGridTextColumn Header="{DynamicResource Loc.Common.HeightM}" Width="160">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="Height"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Adjust.MeanError}" Width="160">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="StandardError"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="{DynamicResource Loc.Adjust.Reference}" Binding="{Binding IsReferencePoint}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource Loc.Adjust.Differences}">
                <DataGrid ItemsSource="{Binding Differences}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc.Common.From}" Binding="{Binding FromPoint}" Width="120"/>
                        <DataGridTextColumn Header="{DynamicResource Loc.Common.To}" Binding="{Binding ToPoint}" Width="120"/>
                        <DataGridTextColumn Header="{DynamicResource Loc.Adjust.Observed}" Width="140">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="ObservedDifference"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Adjust.Adjusted}" Width="140">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="AdjustedDifferenceValue"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Adjust.Residual}" Width="120">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="Residual"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Common.DistanceM}" Width="120">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="DistanceMeters"/>
                                    <Binding Path="DataContext.Document.Settings.DistanceDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Common.StationCount}" Binding="{Binding StationCount}" Width="90"/>
                        <DataGridTextColumn Header="{DynamicResource Loc.Adjust.MeanError}" Width="120">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="OneWay">
                                    <Binding Path="StandardError"/>
                                    <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                             Mode="OneWay"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

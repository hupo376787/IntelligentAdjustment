<UserControl x:Class="IntelligentAdjustment.App.Views.MapSketchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
                <Border
                    Background="{DynamicResource AppSurfaceBrush}"
                    Padding="10"
                    Margin="0,0,0,10"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Map.NetworkPoint}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ComboBox Width="150"
                              ItemsSource="{Binding NetworkPointNames}"
                              SelectedItem="{Binding SelectedPointName, Mode=TwoWay}"
                              Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Loc.Map.PlaceNode}"
                            Command="{Binding StartPlacementCommand}"
                            Padding="12,5"
                            Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Loc.Map.CancelPlacement}"
                            Command="{Binding CancelPlacementCommand}"
                            Padding="12,5"
                            Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource Loc.Map.AutoMissing}"
                            Command="{Binding AutoLayoutUnpositionedCommand}"
                            Padding="12,5"
                            Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Loc.Map.Fit}"
                            Command="{Binding FitToViewCommand}"
                            Padding="12,5"
                            Margin="0,0,14,0"/>
    
                    <CheckBox Content="{DynamicResource Loc.Map.ShowRealDistance}"
                              IsChecked="{Binding ShowRealDistances}"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"/>
    
                    <CheckBox Content="{DynamicResource Loc.Map.Snap}"
                              IsChecked="{Binding SnapEnabled}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Loc.Map.Spacing}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBox Width="58"
                             Text="{Binding SnapSize, UpdateSourceTrigger=LostFocus}"
                             Margin="0,0,12,0"/>
    
                    <TextBlock x:Name="ScaleText"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                </WrapPanel>
            </Border>

            <Expander IsExpanded="True"
                      Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="{DynamicResource Loc.Map.Legend}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                </Expander.Header>
                <Border Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                            <Rectangle Width="13" Height="13" RadiusX="2" RadiusY="2"
                                       Fill="MidnightBlue" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Loc.Map.LegendKnown}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                            <Ellipse Width="13" Height="13" Fill="White" Stroke="SteelBlue"
                                     StrokeThickness="2" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Loc.Map.LegendAdjustment}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                            <Polygon Width="14" Height="14" Points="7,0 14,7 7,14 0,7"
                                     Fill="White" Stroke="DarkOrange" StrokeThickness="2"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Loc.Map.LegendTransition}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="22" Height="14" Margin="0,0,6,0">
                                <Line X1="1" Y1="7" X2="21" Y2="7" Stroke="#BEC5CD" StrokeThickness="1.2"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Loc.Map.LegendObservation}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </Expander>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   Margin="2,8,0,0"
                   TextWrapping="Wrap"/>

        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource AppSurfaceBrush}">
            <Canvas x:Name="SketchCanvas"
                    Background="{DynamicResource AppSurfaceBrush}"
                    ClipToBounds="True"
                    Focusable="True"
                    MouseWheel="SketchCanvas_MouseWheel"
                    MouseLeftButtonDown="SketchCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="SketchCanvas_MouseLeftButtonUp"
                    MouseRightButtonDown="SketchCanvas_MouseRightButtonDown"
                    MouseMove="SketchCanvas_MouseMove"
                    MouseDown="SketchCanvas_MouseDown"
                    MouseUp="SketchCanvas_MouseUp"
                    SizeChanged="SketchCanvas_SizeChanged"/>
        </Border>

    </DockPanel>
</UserControl>

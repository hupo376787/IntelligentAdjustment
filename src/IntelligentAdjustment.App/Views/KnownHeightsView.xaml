<UserControl x:Class="IntelligentAdjustment.App.Views.KnownHeightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:IntelligentAdjustment.App.Behaviors">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="点名" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="150" Text="{Binding NewPointName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                <TextBlock Text="高程 [m]" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="150" Text="{Binding NewHeight, UpdateSourceTrigger=LostFocus}" Margin="0,0,12,0"/>
                <Button Content="添加已知点" Command="{Binding AddKnownHeightCommand}" Padding="12,5" Margin="0,0,6,0"/>
                <Button Content="删除选中" Command="{Binding DeleteSelectedCommand}" Padding="12,5"/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedRows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="点名"
                                    Binding="{Binding PointName, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                    Width="180"/>
                <DataGridTextColumn Header="高程 [m]" Width="160">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource NumericPrecisionConverter}" Mode="TwoWay" UpdateSourceTrigger="LostFocus">
                            <Binding Path="Height" Mode="TwoWay" ValidatesOnDataErrors="True"/>
                            <Binding Path="DataContext.Document.Settings.HeightDecimals"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                                     Mode="OneWay"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="备注" Binding="{Binding Comment, UpdateSourceTrigger=LostFocus}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

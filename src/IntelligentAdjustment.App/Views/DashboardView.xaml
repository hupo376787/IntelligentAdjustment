<UserControl x:Class="IntelligentAdjustment.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="工程概览" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="当前工程信息与数据规模" Foreground="#6B7280" Margin="0,4,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="18" Margin="0,0,12,12" CornerRadius="8" BorderBrush="#E1E5EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="项目名称" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding Document.ProjectName, TargetNullValue=未命名}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="18" Margin="0,0,12,12" CornerRadius="8" BorderBrush="#E1E5EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="高差观测" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding Document.LevelDifferences.Count}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="18" Margin="0,0,12,12" CornerRadius="8" BorderBrush="#E1E5EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="已知高程点" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding Document.KnownHeights.Count}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GroupBox Header="工程信息" Margin="0,8,0,0" Padding="16">
                <Grid Width="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="项目名称" Margin="0,6"/>
                    <TextBox Grid.Column="1" Text="{Binding Document.ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Column="2" Text="项目编号" Margin="12,6,0,6"/>
                    <TextBox Grid.Column="3" Text="{Binding Document.ProjectNumber, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

                    <TextBlock Grid.Row="1" Text="工程单位" Margin="0,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Document.UnitName, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="项目负责人" Margin="12,6,0,6"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Document.ProjectLeader, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

                    <TextBlock Grid.Row="2" Text="审核人" Margin="0,6"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Document.Reviewer, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
